---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { bySlug } from '../data/services';
import { areas } from '../data/areas';
import site from '../data/site.json';

const { s } = Astro.props;
const url = `https://12acrelive.com/${s.slug}`;
const inline = (t: string) => t.replace(/\[([^\]]+)\]\(((?:\/|https:\/\/)[^)]*)\)/g, '<a href="$2">$1</a>');
const related = s.related.map((r: string) => bySlug[r]).filter(Boolean);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.name, serviceType: s.name, url, description: s.description,
    provider: { '@id': 'https://12acrelive.com/#business' },
    areaServed: areas.map((a) => ({ '@type': 'City', name: `${a.name}, ${a.state}` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://12acrelive.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://12acrelive.com/services' },
    { '@type': 'ListItem', position: 3, name: s.name, item: url },
  ] },
];
const withCities = areas.filter((a) => a.uses.some(([sl]) => sl === s.slug));
---
<Base title={s.metaTitle} description={s.description} schema={schema}>
  <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: s.name }]} />
  <section class="hero" style="padding-top:70px">
    <div class="wrap">
      <p class="eyebrow">{s.eyebrow}</p>
      <h1>{s.h1}</h1>
      <p class="lead">{s.lead}</p>
      <div class="actions">
        {s.gentle ? <a class="btn" href={`tel:${site.phoneHref}`}>Call {site.phone}</a> : <a class="btn" href="/contact">{s.cta}</a>}
        {s.gentle ? <a class="btn ghost" href="/contact">{s.cta}</a> : <a class="btn ghost" href="#faq">Common questions</a>}
      </div>
    </div>
  </section>

  <section style="padding-top:88px">
    <div class="wrap narrow prose">
      {s.sections.map((sec: any, i: number) => (
        <div style={i > 0 ? 'margin-top:48px' : ''}>
          <h2>{sec.h2}</h2>
          {sec.paras?.map((p: string) => <p set:html={inline(p)} />)}
          {sec.bullets && (i === 3 ? <ol class="steps">{sec.bullets.map((b: string) => <li set:html={inline(b)} />)}</ol> : <ul>{sec.bullets.map((b: string) => <li set:html={inline(b)} />)}</ul>)}
        </div>
      ))}
      {s.slug === 'funeral-live-streaming' && <p style="margin-top:32px">Families can also read about our approach on the <a href={`${site.parent}/funeral-live-streaming`}>12 Acre Films funeral live streaming page</a>.</p>}

      <div style="margin-top:48px">
        <h2>Where we stream {s.name.toLowerCase().replace(' live streaming', '').replace(' production', '')} events</h2>
        <p>Based in Spokane, we travel across the Inland Northwest. Pick your city for local venues, drive times, and the events we plan around:</p>
        <ul style="columns:2 240px">
          {(withCities.length ? withCities : areas).map((a) => <li><a href={`/areas/${a.slug}`}>{a.name}, {a.state}</a></li>)}
        </ul>
        <p><a href="/areas">See every city we serve</a></p>
      </div>
    </div>
  </section>

  <section id="faq" style="background:var(--surface);border-block:1px solid var(--line)">
    <div class="wrap narrow">
      <h2>Frequently asked questions</h2>
      {s.faqs.map((f: any) => (
        <details style="border-bottom:1px solid var(--line);padding:14px 0">
          <summary style="cursor:pointer;font-weight:600">{f.q}</summary>
          <p class="muted" style="margin:10px 0 0">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Related services</h2>
      <div class="grid cols-3">
        {related.map((r: any) => (
          <a class="card" href={`/${r.slug}`} style="text-decoration:none">
            <div class="body"><h3>{r.name}</h3><p class="muted" style="margin:0">{r.short}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
