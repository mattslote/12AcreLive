<form class="contact" novalidate>
        <div class="row">
          <label>Name *<input name="name" required autocomplete="name" /></label>
          <label>Email *<input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="row">
          <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
          <label>Company / organization<input name="company" autocomplete="organization" /></label>
        </div>
        <div class="row">
          <label>Project type
            <select name="projectType">
              <option value="">Select…</option>
              <option>Conference or summit</option>
              <option>Hybrid event</option>
              <option>Gala or fundraiser</option>
              <option>Webinar or studio broadcast</option>
              <option>Church service or ceremony</option>
              <option>Graduation or school event</option>
              <option>Concert or performance</option>
              <option>Event recording (no live stream)</option>
              <option>Funeral / memorial live stream</option>
              <option>Something else</option>
            </select>
          </label>
          <label>Budget range
            <select name="budget">
              <option value="">Not sure yet</option>
              <option>Under $2,500</option>
              <option>$2,500 – $5,000</option>
              <option>$5,000 – $10,000</option>
              <option>$10,000 – $25,000</option>
              <option>$25,000+</option>
            </select>
          </label>
        </div>
        <label>Timeline<input name="timeline" placeholder="e.g. event date, and when you need the recording" /></label>
        <label>Tell me about your event *<textarea name="message" required></textarea></label>

        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

        <div  class="status" role="status" aria-live="polite"></div>
        <div><button class="btn" type="submit" >Send message</button></div>
</form>
